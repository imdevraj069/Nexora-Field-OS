NODE_ENV=development
DEPLOYMENT_PROFILE=dev

# --- Cloudflare Tunnel (used only when --profile tunnel is enabled) ---
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_APP_HOST=app.nexora.example.com
PUBLIC_API_HOST=api.nexora.example.com
PUBLIC_WS_HOST=ws.nexora.example.com

# --- Identity & Security ---
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Storage Service Keys (Internal Backend <-> Storage <-> AI) ---
MASTER_STORAGE_KEY=local-master-storage-key
MASTER_READ_KEY=local-master-read-key
SIGNED_URL_SECRET=local-signed-url-secret
MINIO_ROOT_USER=nexoraadmin
MINIO_ROOT_PASSWORD=nexoraadmin123
MINIO_STORAGE_ACCESS_KEY=nexora-storage-svc
MINIO_STORAGE_SECRET_KEY=nexora-storage-secret-123
MINIO_ENDPOINT=http://minio:9000

# --- RabbitMQ & Gmail SMTP (leave Gmail blank for stdout dry-run in local dev) ---
RABBITMQ_USER=nexora_mq
RABBITMQ_PASSWORD=nexora_mq_pass
RABBITMQ_URL=amqp://nexora_mq:nexora_mq_pass@rabbitmq:5672
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MAIL_FROM_NAME=Nexora Field OS

# --- AI Governance Service (leave GEMINI_API_KEY blank for deterministic fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- PostgreSQL (Dev Profile -> single pg-dev container hosting all 5 DBs) ---
PG_USER=nexora
PG_PASSWORD=nexora_pass
PG_GLOBAL_URL=postgresql://nexora:nexora_pass@pg-dev:5432/nexora_global
PG_BACKUP_URL=postgresql://nexora:nexora_pass@pg-dev:5432/nexora_backup
PG_SHARD1_PRIMARY_URL=postgresql://nexora:nexora_pass@pg-dev:5432/nexora_s1
PG_SHARD1_REPLICAS=
PG_SHARD2_PRIMARY_URL=postgresql://nexora:nexora_pass@pg-dev:5432/nexora_s2
PG_SHARD2_REPLICAS=
PG_SHARD3_PRIMARY_URL=postgresql://nexora:nexora_pass@pg-dev:5432/nexora_s3
PG_SHARD3_REPLICAS=

# --- MongoDB (Dev Profile -> single mongo-dev container) ---
MONGO_SHARD1_URI=mongodb://mongo-dev:27017/nexora_s1
MONGO_SHARD2_URI=mongodb://mongo-dev:27017/nexora_s2
MONGO_SHARD3_URI=mongodb://mongo-dev:27017/nexora_s3

# --- Redis (Dev Profile -> single redis-dev container) ---
REDIS_GLOBAL_URL=redis://redis-dev:6379
REDIS_SHARD1_URL=redis://redis-dev:6379
REDIS_SHARD2_URL=redis://redis-dev:6379
REDIS_SHARD3_URL=redis://redis-dev:6379

# --- Internal Service Addresses ---
IDENTITY_GRPC_URL=identity-service:50051
IDENTITY_HTTP_URL=http://identity-service:4001
STORAGE_GRPC_URL=storage-service:50052
STORAGE_HTTP_URL=http://storage-service:4002
AI_GRPC_URL=ai-governance-service:50053
API_GATEWAY_URL=http://gateway-service:4000
