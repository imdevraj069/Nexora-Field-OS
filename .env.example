# ==============================================================================
# Nexora Field OS — Environment Template
# Copy to .env and replace all placeholder secrets before running Docker Compose.
# ==============================================================================

NODE_ENV=production
DEPLOYMENT_PROFILE=dev

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
PUBLIC_APP_HOST=app.nexora.example.com
PUBLIC_API_HOST=api.nexora.example.com
PUBLIC_WS_HOST=ws.nexora.example.com

# --- Identity & Security ---
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Storage Service Keys (Strictly Internal Backend <-> Storage <-> AI) ---
MASTER_STORAGE_KEY=replace-with-master-storage-upload-key
MASTER_READ_KEY=replace-with-master-storage-read-key
SIGNED_URL_SECRET=replace-with-signed-url-hmac-secret
MINIO_ROOT_USER=nexoraadmin
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_STORAGE_ACCESS_KEY=nexora-storage-svc
MINIO_STORAGE_SECRET_KEY=replace-with-minio-svc-secret
MINIO_ENDPOINT=http://minio:9000

# --- RabbitMQ & Gmail SMTP (Worker Service) ---
RABBITMQ_USER=nexora_mq
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_URL=amqp://nexora_mq:replace-with-rabbitmq-password@rabbitmq:5672
GMAIL_SMTP_USER=your-sender@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-16-char-gmail-app-password
MAIL_FROM_NAME=Nexora Field OS

# --- AI Governance Service ---
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_FFMPEG_PATH=/usr/bin/ffmpeg

# --- PostgreSQL (Global Control Plane + 3 Shards + Logical Backup) ---
PG_USER=nexora
PG_PASSWORD=replace-with-postgres-password
PG_GLOBAL_URL=postgresql://nexora:replace-with-postgres-password@pg-global:5432/nexora_global
PG_BACKUP_URL=postgresql://nexora:replace-with-postgres-password@pg-backup:5432/nexora_backup

# In `dev` profile, point Shard 1..3 to the single Postgres host with distinct DBs.
# In `cluster` profile, point each shard primary & 3 read replicas to dedicated hosts.
PG_SHARD1_PRIMARY_URL=postgresql://nexora:replace-with-postgres-password@pg-shard1:5432/nexora_s1
PG_SHARD1_REPLICAS=postgresql://nexora:replace-with-postgres-password@pg-shard1-r1:5432/nexora_s1,postgresql://nexora:replace-with-postgres-password@pg-shard1-r2:5432/nexora_s1,postgresql://nexora:replace-with-postgres-password@pg-shard1-r3:5432/nexora_s1

PG_SHARD2_PRIMARY_URL=postgresql://nexora:replace-with-postgres-password@pg-shard2:5432/nexora_s2
PG_SHARD2_REPLICAS=postgresql://nexora:replace-with-postgres-password@pg-shard2-r1:5432/nexora_s2,postgresql://nexora:replace-with-postgres-password@pg-shard2-r2:5432/nexora_s2,postgresql://nexora:replace-with-postgres-password@pg-shard2-r3:5432/nexora_s2

PG_SHARD3_PRIMARY_URL=postgresql://nexora:replace-with-postgres-password@pg-shard3:5432/nexora_s3
PG_SHARD3_REPLICAS=postgresql://nexora:replace-with-postgres-password@pg-shard3-r1:5432/nexora_s3,postgresql://nexora:replace-with-postgres-password@pg-shard3-r2:5432/nexora_s3,postgresql://nexora:replace-with-postgres-password@pg-shard3-r3:5432/nexora_s3

# --- MongoDB (3 Shards) ---
MONGO_SHARD1_URI=mongodb://mongo-shard1:27017/nexora_s1
MONGO_SHARD2_URI=mongodb://mongo-shard2:27017/nexora_s2
MONGO_SHARD3_URI=mongodb://mongo-shard3:27017/nexora_s3

# --- Redis (Per-Shard Cache + PubSub) ---
REDIS_SHARD1_URL=redis://redis-shard1:6379
REDIS_SHARD2_URL=redis://redis-shard2:6379
REDIS_SHARD3_URL=redis://redis-shard3:6379
REDIS_GLOBAL_URL=redis://redis-global:6379

# --- Internal Service Addresses ---
IDENTITY_GRPC_URL=identity:50051
IDENTITY_HTTP_URL=http://identity:4001
STORAGE_GRPC_URL=storage:50052
STORAGE_HTTP_URL=http://storage:4002
AI_GRPC_URL=ai-governance:50053
API_GATEWAY_URL=http://api-gateway:4000
